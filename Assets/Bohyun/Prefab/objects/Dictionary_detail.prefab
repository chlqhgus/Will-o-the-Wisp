--- !u!114 &7314207219054704369
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7559896945622201840}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 94162e5f3986f40fb89913704593b11d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DictionaryDetailManager
  faceImage: {fileID: 285977788103075875}
  pageImage: {fileID: 4744903196081078736}
  detailText: {fileID: 3562041059246663228}
  leftButton: {fileID: 6923507571516326848}
  rightButton: {fileID: 8417106982260086908}
  closeButton: {fileID: 6241182288462499481}
  commonPageImage: {fileID: -1229905482659958042, guid: 3292afc9e49f04fb69fc8141856248a2, type: 3}
  bookSoundEffect: {fileID: 8300000, guid: a2f1f642d130b4005a2b752d686fb5b5, type: 3}
  audioSource: {fileID: 0}
  pages:
  - faceImage: {fileID: -7136524316631348995, guid: ddfad20367ad14a71960c2a8e0764ead, type: 3}
    textSegments:
    - text: "The outer corners of the eyes tilt upward.\n\r\nLarge ears\n\r\nNot
        eat humans\u2014but it is an excellent "
      isBold: 0
    - text: LIAR
      isBold: 1
    - text: "\u2026\n\r\nSuspiciously interested in human money."
      isBold: 0
  - faceImage: {fileID: 7488313383368834622, guid: 767e5b7e5c7ed4caa87220cae617bd59, type: 3}
    textSegments:
    - text: "Large eyes and an unusually long smile line\n\r\nHuge build but always
        starving\n\r\nDocile as long as it\u2019s well-fed\n\nWhen hungry, it becomes  "
      isBold: 0
    - text: THE MOST DANGEROUS
      isBold: 1
    - text: "creature\u2026"
      isBold: 0
  - faceImage: {fileID: 3192298445268409882, guid: bfac6ec5e12b04c87b3b60a8deb27b22, type: 3}
    textSegments:
    - text: 'Has a large jaw, with extremely greedy personality


        When angry,
        touches its neck and avoids eye contact


        If its request is refused,
        it becomes  '
      isBold: 0
    - text: "FURIOUS AND TRIES TO BITE  \n"
      isBold: 1
    - text: "with its jaw\u2026 \n\nBe  "
      isBold: 0
    - text: CAREFUL
      isBold: 1
    - text: '  not to let that jaw tear your flesh.'
      isBold: 0
