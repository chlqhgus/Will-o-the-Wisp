--- !u!114 &7314207219054704369
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7559896945622201840}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 94162e5f3986f40fb89913704593b11d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DictionaryDetailManager
  faceImage: {fileID: 285977788103075875}
  pageImage: {fileID: 4744903196081078736}
  featureText: {fileID: 2844036760572416560}
  descriptionText: {fileID: 3562041059246663228}
  leftButton: {fileID: 6923507571516326848}
  rightButton: {fileID: 8417106982260086908}
  closeButton: {fileID: 6241182288462499481}
  commonPageImage: {fileID: -1229905482659958042, guid: 3292afc9e49f04fb69fc8141856248a2, type: 3}
  bookSoundEffect: {fileID: 8300000, guid: a2f1f642d130b4005a2b752d686fb5b5, type: 3}
  audioSource: {fileID: 0}
  pages:
  - faceImage: {fileID: -7136524316631348995, guid: ddfad20367ad14a71960c2a8e0764ead, type: 3}
    featureText: '- Upturned eyes with a smiling expression


      - Large ears'
    descriptionText: "The outer corners of the eyes tilt upward.\n\nNot eat humans\u2014but
      it is an excellent LIAR\u2026\n\nSuspiciously interested in human money."
  - faceImage: {fileID: 7488313383368834622, guid: 767e5b7e5c7ed4caa87220cae617bd59, type: 3}
    featureText: '- Big, round eyes


      - Extremely long mouth corners


      -
      Broad shoulders and a protruding belly'
    descriptionText: "It huge, but always starving.\n\nDocile as long as it\u2019s
      well-fed.\n\nBut when hungry, it becomes THE MOST DANGEROUS creature to humans\u2026"
  - faceImage: {fileID: -3667131600824562435, guid: b24450b6bda364307ac7f0bbb3df7c4e, type: 3}
    featureText: '- Narrow, delicate eyes


      - Pale skin'
    descriptionText: "Has pointed ears, pale skin.\n\nSpeaks in a very polite manner.\nBut
      that does not mean she is kind\u2026\n\nSeems to dislike humans who disobey
      her."
  - faceImage: {fileID: 3192298445268409882, guid: bfac6ec5e12b04c87b3b60a8deb27b22, type: 3}
    featureText: '- Large, prominent jaw


      - Neck shows scratch-like marks
      made by its own fingers'
    descriptionText: "Extremely greedy.\n\nWhen angry, touches its neck and avoids
      eye contact.\n\nIf its request is refused, it becomes furious and tries to
      bite with its jaw\u2026\n\nBe CAREFUL not to let that jaw tear your flesh."
  - faceImage: {fileID: -5643401755176094002, guid: 10c66b87101c94ac991a70afcc4901b5, type: 3}
    featureText: '- Eyes slant downward.


      - Slightly upturned mouth, a faint
      smiling face.


      - Has three horns.'
    descriptionText: "Always smiling in a flimsy - annoying way.\n\nGood at lying
      - don\u2019t let it trick you.\n\n...But it might share useful info if treated
      well."
  - faceImage: {fileID: 6843335327786611419, guid: 473a562c15e814bb9942bbc3efef39d2, type: 3}
    featureText: "- Long beard. \n\n- Small eyes. "
    descriptionText: "Extremely violent.\n\nLooks down on humans more than anyone.
      \n\nThe Dokkaebi with the highest human kill count!!"
